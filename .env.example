# ============================================================
# Newa Store — environment configuration (copy to .env)
# NEVER commit the real .env file.
# ============================================================

# --- Django core ---
DJANGO_SECRET_KEY=django-insecure-CHANGE-ME
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Absolute base URL for links in transactional emails
SITE_BASE_URL=http://localhost:8000

# --- Database: PostgreSQL only (SQLite support was removed) ---
DB_NAME=newastore
DB_USER=newastore
DB_PASSWORD=CHANGE-ME
DB_HOST=localhost
DB_PORT=5433

# --- Email: real Gmail SMTP ---
# EMAIL_HOST_PASSWORD must be a 16-char Gmail APP PASSWORD (keep its spaces),
# generated at https://myaccount.google.com/apppasswords after enabling
# 2-Step Verification. The normal account password will NOT work for SMTP.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD="xxxx xxxx xxxx xxxx"
DEFAULT_FROM_EMAIL=you@gmail.com

# --- Payments ---
# eSewa and Khalti are SIMULATED in this demo (store/payments.py renders a
# local look-alike payment page; nothing is charged). Their keys are optional.
ESEWA_MERCHANT_CODE=
ESEWA_SECRET_KEY=
ESEWA_URL=

KHALTI_PUBLIC_KEY=
KHALTI_SECRET_KEY=

# --- Payments: Stripe (pk_/sk_ test keys) ---
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
# CLI: stripe listen --forward-to localhost:8000/webhooks/stripe/
STRIPE_WEBHOOK_SECRET=
# Stripe does not support NPR — set a supported currency for the charge
STRIPE_CURRENCY=usd
STRIPE_PRICE_LABEL=USD $

# --- Payments: PayPal (sandbox app credentials) ---
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=usd
PAYPAL_PRICE_LABEL=USD $
PAYPAL_SANDBOX=True

# --- Imports / seeding ---
USD_TO_NPR=135
SEED_MAX_REQUESTS=400
SEED_ENRICH=150
# ============================================================
# Newa Store — environment configuration (copy to .env)
# NEVER commit the real .env file.
# ============================================================

# --- Django core ---
DJANGO_SECRET_KEY=django-insecure-CHANGE-ME
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Absolute base URL for links in transactional emails
SITE_BASE_URL=http://localhost:8000

# --- Database: postgres (default) or sqlite ---
DJANGO_DB=postgres
DB_NAME=newastore
DB_USER=newastore
DB_PASSWORD=CHANGE-ME
DB_HOST=localhost
DB_PORT=5433

# --- Email (dev default is console — prints to terminal) ---
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL="Newa Store <no-reply@newastore.com>"

# --- Payments: eSewa (test keys) ---
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form

# --- Payments: Khalti ---
KHALTI_PUBLIC_KEY=
KHALTI_SECRET_KEY=

# --- Payments: Stripe (pk_/sk_ test keys) ---
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
# CLI: stripe listen --forward-to localhost:8000/webhooks/stripe/
STRIPE_WEBHOOK_SECRET=
# Stripe does not support NPR — set a supported currency for the charge
STRIPE_CURRENCY=usd
STRIPE_PRICE_LABEL=USD $

# --- Payments: PayPal (sandbox app credentials) ---
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=usd
PAYPAL_PRICE_LABEL=USD $
PAYPAL_SANDBOX=True

# --- Imports / seeding ---
USD_TO_NPR=135
SEED_MAX_REQUESTS=400
SEED_ENRICH=150
# ============================================================
# Newa Store — environment configuration (copy to .env)
# NEVER commit the real .env file.
# ============================================================

# --- Django core ---
DJANGO_SECRET_KEY=django-insecure-CHANGE-ME
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Absolute base URL for links in transactional emails
SITE_BASE_URL=http://localhost:8000

# --- Bootstrap accounts ---
# `manage.py ensure_ready` (run automatically by runserver) seeds these two
# accounts and resets their passwords to match on every boot, so /admin login
# always agrees with this file. Change them before any real deployment.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=CHANGE-ME
DEMO_USER_USERNAME=demo
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=CHANGE-ME

# --- Database: PostgreSQL only (SQLite support was removed) ---
DB_NAME=newastore
DB_USER=newastore
DB_PASSWORD=CHANGE-ME
DB_HOST=localhost
DB_PORT=5433

# --- Email: real Gmail SMTP ---
# EMAIL_HOST_PASSWORD must be a 16-char Gmail APP PASSWORD (keep its spaces),
# generated at https://myaccount.google.com/apppasswords after enabling
# 2-Step Verification. The normal account password will NOT work for SMTP.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD="xxxx xxxx xxxx xxxx"
DEFAULT_FROM_EMAIL=you@gmail.com

# --- Payments: eSewa (real ePay v2 sandbox) ---
# Defaults use eSewa's public "rc" sandbox (product code EPAYTEST). The RC test
# secret is publicly documented, so the checkout works out of the box with test
# eSewa IDs and no real money moves. Swap in your live product code + secret and
# the production URLs to go live.
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/
# Nay Bank Transfer settles offline and needs no keys — it is always available.

# --- Imports / seeding ---
USD_TO_NPR=135
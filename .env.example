# ============================================================
# NewaStore — environment configuration (copy to .env)
# NEVER commit the real .env file.
# ============================================================

# --- Django core ---
DJANGO_SECRET_KEY=CHANGE-ME-use-at-least-50-random-characters
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Absolute base URL for links in transactional emails
SITE_BASE_URL=http://localhost:8000

# --- Administration and one-time development bootstrap ---
# Prefer `python manage.py createsuperuser`. If BOOTSTRAP_ACCOUNTS=True,
# ensure_ready creates missing accounts ONCE; it never resets a password or
# elevates an existing user. Keep this False in production.
BOOTSTRAP_ACCOUNTS=False
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
DEMO_USER_USERNAME=
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
# Optional non-default admin URL segment and optional IP/CIDR allow-list.
DJANGO_ADMIN_PATH=admin
DJANGO_ADMIN_ALLOWED_NETWORKS=
# Set these only behind a trusted TLS-terminating proxy (Render sets both).
DJANGO_TRUST_X_FORWARDED_PROTO=False
DJANGO_TRUST_X_FORWARDED_FOR=False
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database: PostgreSQL only (SQLite support was removed) ---
DB_NAME=newastore
DB_USER=newastore
DB_PASSWORD=CHANGE-ME
DB_HOST=localhost
DB_PORT=5433
# Production only; prefer verify-full when your provider supplies a CA bundle.
DB_SSLMODE=require

# --- Email: real Gmail SMTP ---
# EMAIL_HOST_PASSWORD must be a 16-char Gmail APP PASSWORD (keep its spaces),
# generated at https://myaccount.google.com/apppasswords after enabling
# 2-Step Verification. The normal account password will NOT work for SMTP.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD="xxxx xxxx xxxx xxxx"
DEFAULT_FROM_EMAIL=you@gmail.com

# --- Payments: eSewa (real ePay v2 sandbox) ---
# Defaults use eSewa's public "rc" sandbox (product code EPAYTEST). The RC test
# secret is publicly documented, so the checkout works out of the box with test
# eSewa IDs and no real money moves. Swap in your live product code + secret and
# the production URLs to go live.
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc.esewa.com.np/api/epay/transaction/status/
ESEWA_VERIFY_STATUS=False
ESEWA_ORDER_TTL_MINUTES=30
# eSewa mode: "false" (default) posts to the real eSewa RC test gateway — shoppers
# see eSewa's own hosted payment page (EPAYTEST = no real money). Use "true" for the
# in-site demo page, or "auto" to simulate only on the EPAYTEST code (legacy).
ESEWA_SIMULATE=false

# --- Offline bank transfer ---
# Development values are placeholders. Production keeps this method disabled
# until real account details are supplied.
BANK_TRANSFER_ENABLED=True
BANK_TRANSFER_BANK_NAME=Nay Bank
BANK_TRANSFER_ACCOUNT_NAME=NewaStore Pvt. Ltd.
BANK_TRANSFER_ACCOUNT_NUMBER=CHANGE-ME
BANK_TRANSFER_BRANCH=Kathmandu
BANK_TRANSFER_SWIFT=
BANK_TRANSFER_ORDER_TTL_HOURS=168

# --- Imports / seeding ---
USD_TO_NPR=135

# Optional extra HTTPS hosts approved for the server-side artwork downloader.
# The built-in Steam CDN hosts are already allowed.
ARTWORK_ALLOWED_HOSTS=
# Public searches should not write to the production catalog by default.
ENABLE_LIVE_SEARCH_IMPORT=True
